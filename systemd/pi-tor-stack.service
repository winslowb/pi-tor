[Unit]
Description=pi-tor-pihole docker compose stack
After=docker.service pi-tor-gadget.service pi-tor-guard.service
# starting the stack starts the gadget too; Wants (not Requires) keeps a
# gadget failure from holding the stack back -- the UI then explains it
Wants=pi-tor-gadget.service
# the :53 guard must exist before docker starts pihole (listeningMode=ALL), so
# a guard that cannot be installed fails this unit too: no unguarded resolver
Requires=pi-tor-guard.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/pi-tor
# literal: systemd cannot expand a variable into a path
WorkingDirectory=/opt/pi-tor
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
