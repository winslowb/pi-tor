# Copy this file to /etc/default/pi-tor-ap and keep it root-only:
#   sudo install -m 0600 systemd/pi-tor-ap.env.example /etc/default/pi-tor-ap
#
# Wi-Fi AP (guest) mode -- bin/pi-tor-ap and pi-tor-ap.service. The tether
# interface, gateway, TransPort and DNS port these rules use come from
# /etc/default/pi-tor (PI_TOR_INTERFACE, PI_TOR_GATEWAY, PI_TOR_TRANS_PORT).

# Network name guests see (1-32 characters)
PI_TOR_AP_SSID=pi-tor guest

# WPA2-PSK passphrase, 8-63 characters, no whitespace. There is no open mode:
# leaving this empty makes `pi-tor-ap up` refuse to start.
PI_TOR_AP_PSK=

# Guest interface (a virtual AP interface added to the uplink radio) and its
# addressing. The subnet must be a /24: the DHCP pool is derived from it.
PI_TOR_AP_INTERFACE=uap0
PI_TOR_AP_SUBNET=10.12.195.0/24
PI_TOR_AP_GATEWAY=10.12.195.1

# Optional: override the DHCP pool (default: .100-.199 of the gateway's /24)
#PI_TOR_AP_DHCP_START=10.12.195.100
#PI_TOR_AP_DHCP_END=10.12.195.199
